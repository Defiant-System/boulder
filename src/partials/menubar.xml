<MenuBar>
	<Menu name="Boulder Dash">
		<Menu name="About Boulder Dash" shell="win -a"/>
		<Menu type="divider"/>
		<Menu name="Quit Boulder Dash" shell="win -c"/>
	</Menu>
	<Menu name="Game" for="game-view">
		<Menu name="Show&#8230;">
			<Menu name="Start" click="show-view" arg="start"/>
			<Menu name="Game" click="show-view" arg="game"/>
			<Menu type="divider"/>
			<Menu name="Toggle Shadow" click="toggle-shadow"/>
			<Menu name="Editor Scale&#8230;">
				<Menu name="1" check-group="editor-scale" click="set-scale" arg="1"/>
				<Menu name=".75" check-group="editor-scale" click="set-scale" arg=".75"/>
				<Menu name=".5" check-group="editor-scale" click="set-scale" arg=".5" is-checked="1"/>
				<Menu name=".25" check-group="editor-scale" click="set-scale" arg=".25"/>
				<Menu name=".175" check-group="editor-scale" click="set-scale" arg=".175"/>
			</Menu>
			<Menu name="Editor Levels&#8230;">
				<Menu name="1" check-group="editor-level" click="show-view" arg="editor,1" is-checked="1"/>
				<Menu name="2" check-group="editor-level" click="show-view" arg="editor,2"/>
				<Menu name="3" check-group="editor-level" click="show-view" arg="editor,3"/>
				<Menu name="4" check-group="editor-level" click="show-view" arg="editor,4"/>
				<Menu name="5" check-group="editor-level" click="show-view" arg="editor,5"/>
				<Menu name="6" check-group="editor-level" click="show-view" arg="editor,6"/>
				<Menu name="7" check-group="editor-level" click="show-view" arg="editor,7"/>
				<Menu name="8" check-group="editor-level" click="show-view" arg="editor,8"/>
				<Menu name="9" check-group="editor-level" click="show-view" arg="editor,9"/>
				<Menu name="10" check-group="editor-level" click="show-view" arg="editor,10"/>
				<Menu name="11" check-group="editor-level" click="show-view" arg="editor,11"/>
				<Menu name="12" check-group="editor-level" click="show-view" arg="editor,12"/>
				<Menu name="13" check-group="editor-level" click="show-view" arg="editor,13"/>
				<Menu name="14" check-group="editor-level" click="show-view" arg="editor,14"/>
				<Menu name="15" check-group="editor-level" click="show-view" arg="editor,15"/>
				<Menu name="16" check-group="editor-level" click="show-view" arg="editor,16"/>
				<Menu name="17" check-group="editor-level" click="show-view" arg="editor,17"/>
				<Menu name="18" check-group="editor-level" click="show-view" arg="editor,18"/>
				<Menu name="19" check-group="editor-level" click="show-view" arg="editor,19"/>
				<Menu name="20" check-group="editor-level" click="show-view" arg="editor,20"/>
			</Menu>
		</Menu>
	</Menu>
	<Menu name="Help">
		<Menu name="Help" click="open-help"/>
		<Menu type="divider"/>
		<Menu name="License" shell="win -al"/>
	</Menu>
</MenuBar>